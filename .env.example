# LOCAL mode: fake AWS (moto) on your PC - costs nothing.
AWS_ENDPOINT_URL=http://localhost:5000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_BUCKET=aivg-learning-local
JOBS_TABLE=aivg-learning-VideoJobs
SCENES_TABLE=aivg-learning-VideoScenes

ALLOW_REAL_AWS=false

# LLM: fake = offline, free. (Bedrock only in .env.aws)
LLM_PROVIDER=fake
