# Local AWS emulator (moto) - costs nothing.
AWS_ENDPOINT_URL=http://localhost:5000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_BUCKET=ai-video-generator-local
JOBS_TABLE=VideoJobs
SCENES_TABLE=VideoScenes

# SAFETY: keep false. If AWS_ENDPOINT_URL is empty, boto3 would talk to REAL AWS
# (which can cost money). The app refuses to do that unless this is true.
ALLOW_REAL_AWS=false
