# REAL AWS mode (company account). Use with:  $env:ENV_FILE=".env.aws"
# No keys here! They live in ~/.aws/credentials under the profile below
# (created with:  aws configure --profile aivg).
AWS_ENDPOINT_URL=
AWS_PROFILE=aivg
AWS_REGION=us-east-1

# S3 bucket names are global across ALL AWS customers, so the setup script
# appends your account id to make it unique: aivg-learning-<account-id>
S3_BUCKET=
JOBS_TABLE=aivg-learning-VideoJobs
SCENES_TABLE=aivg-learning-VideoScenes

# Deliberate opt-in to real (billed) AWS.
ALLOW_REAL_AWS=true

# ---- Bedrock (PAID per token) ----
# fake = free offline stand-in; bedrock = real model calls
LLM_PROVIDER=fake
# eu. = EU cross-region inference profile (required from Stockholm)
BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
# approx USD per 1M tokens, only for printed estimates
PRICE_INPUT_PER_M=0.05
PRICE_OUTPUT_PER_M=0.18
MAX_OUTPUT_TOKENS=4000
